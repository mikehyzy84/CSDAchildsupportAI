# =============================================================================
# CSDAI — Environment Variables
# Copy this file to .env and fill in your values.
# =============================================================================

# --- Required ---

# Anthropic API key for Claude-powered chat (api/chat.ts)
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Neon (or Postgres) database connection string (used by all /api endpoints)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Optional / Feature-specific ---

# ElevenLabs voice chat integration (api/elevenlabs-signed-url.ts)
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_AGENT_ID=your_elevenlabs_agent_id

# Bearer token to protect the /api/scrape-legal-docs endpoint
SCRAPER_API_KEY=your_scraper_api_key

# Legacy: OpenAI key used by server.js (local dev server only, not used in production)
OPENAI_API_KEY=sk-proj-xxxxx

# Set to "production" on deployed environments
NODE_ENV=development
